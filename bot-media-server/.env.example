# llm_engine connection
LLM_ENGINE_URL=http://localhost:3000/v1
LLM_ENGINE_WS_URL=ws://localhost:5555
LLM_ENGINE_USERNAME=output-media-bot
LLM_ENGINE_PASSWORD=


# Text-to-speech: "kokoro" (default, works anywhere Node runs) or "say" (macOS only, zero
# setup — no model download). See bot-media-server/tts/ and the README.
# TTS_ENGINE=kokoro

# TTS_ENGINE=say only:
# SAY_VOICE=

# TTS_ENGINE=kokoro only. By default the model must already be staged at KOKORO_MODEL_DIR —
# no automatic download unless KOKORO_ALLOW_REMOTE_MODELS=true below. See the README's
# "Staging the Kokoro model" section.
# KOKORO_VOICE=af_heart
# KOKORO_MODEL_DIR=
# KOKORO_SPEED=1
#
# Set to "true" to download missing model files into KOKORO_MODEL_DIR on demand instead of
# requiring them staged ahead of time. Recommended for local dev only — not production, where
# an interrupted download can leave a corrupted model file that fails opaquely later.
# KOKORO_ALLOW_REMOTE_MODELS=true


# Server
PORT=3100

