# Convert text file line endings to lf
* text eol=lf
*.js text
*.pdf binary

# Binary media assets — opt out of the blanket `* text eol=lf` rule above. Without this,
# git treats them as text and normalizes line endings, silently corrupting any byte pair
# that happens to match CRLF anywhere in the binary/compressed stream (this is exactly
# what happened to bot-media-server/public/bot.png and bot.mp4).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp4 binary
*.mov binary
*.webm binary

# CSV import test fixtures: exact bytes (CRLF endings, a raw control character, no BOM)
# are the point of these files — don't let line-ending normalization rewrite them.
tests/fixtures/csv/*.csv -text
